---
import type { placeholderPages } from '../data/site';
import ArrowLink from './ArrowLink.astro';

type Page = (typeof placeholderPages)[keyof typeof placeholderPages];
interface Props { page: Page }
const { page } = Astro.props;
---

<section class="placeholder-page">
  <div class="shell placeholder-inner">
    <div>
      <p class="eyebrow"><span aria-hidden="true"></span>{page.eyebrow}</p>
      <h1>{page.title}</h1>
    </div>
    <div class="placeholder-copy">
      <p>{page.description}</p>
      <ArrowLink href="/" label="Revenir à l’accueil" />
    </div>
    <div class="placeholder-art" aria-hidden="true">
      <span>En cours de création</span>
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
  </div>
</section>
