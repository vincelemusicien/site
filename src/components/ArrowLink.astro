---
interface Props {
  href: string;
  label: string;
  external?: boolean;
  light?: boolean;
}
const { href, label, external = false, light = false } = Astro.props;
---

<a class:list={['arrow-link', { light }]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
  <span>{label}</span><i aria-hidden="true">↗</i>
</a>
