---
interface Props {
  metaDisclaimer?: boolean;
  analyticsEnabled?: boolean;
}

const { metaDisclaimer = false, analyticsEnabled = false } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-simple">
    <p>© {new Date().getFullYear()} Vince / Le Musicien</p>
    <nav aria-label="Pied de page">
      <a href="mailto:vincent@lemusicien.fr">Contact</a>
      <a href="https://productionmusicale.systeme.io/login" target="_blank" rel="noreferrer">Espace membre <span aria-hidden="true">↗</span></a>
      <a href="#">Mentions légales</a>
      <a href="#">Confidentialité</a>
      {analyticsEnabled && <button type="button" data-analytics-settings aria-controls="lm-analytics-consent">Gérer les cookies</button>}
      <a href="#">CGV</a>
    </nav>
  </div>
  {metaDisclaimer && (
    <p class="shell meta-disclaimer">
      Ce site ne fait pas partie de Facebook™ ni de Meta Platforms, Inc. Il n’est ni sponsorisé, ni approuvé, ni administré par Facebook™ ou Meta. Facebook™ et Meta™ sont des marques de Meta Platforms, Inc.
    </p>
  )}
</footer>

<style>
  .site-footer nav button {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .site-footer nav button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .meta-disclaimer {
    margin: -12px auto 0;
    padding: 0 0 25px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 620px) {
    .meta-disclaimer {
      margin-top: -14px;
      padding-bottom: 30px;
      text-align: left;
    }
  }
</style>
