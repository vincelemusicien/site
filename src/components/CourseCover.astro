---
interface Props { title: string; category: string; image?: string | null; badge?: string; }
const { title, category, image, badge = 'Inclus' } = Astro.props;
---
<div class:list={['lp-cover', { 'lp-cover-type': !image, 'lp-cover-long': title.length > 25 }]}>
  <span class="lp-cover-category">{category}</span><h3>{title}</h3>
  {image ? <img src={image} alt={`Visuel de la formation ${title}`} width="640" height="380" loading="lazy" decoding="async" /> : <span class="lp-type-caption">Le Musicien<span>La bibliothèque de Vince</span></span>}
  {badge && <span class="lp-cover-included">{badge}</span>}
</div>
