---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberCourse from '../../components/MemberCourse.astro';
import OptionIcon from '../../components/OptionIcon.astro';
import { memberCourses, memberUniverses, memberDiscovery, memberAccess } from '../../data/member-pass';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import liveSource from '../../../public/images/pass/pm-school-live.jpeg';
import '../../styles/pass-library.css';
import '../../styles/member-pass.css';
const sources = import.meta.glob<{ default: ImageMetadata }>('../../../public/images/**/*.{png,webp}', { eager: true });
const pictures = Object.fromEntries(await Promise.all([...new Set(memberCourses.map(course => course.image).filter(Boolean))].map(async path => {
  const source = sources[`../../../public${path}`]?.default;
  return [path!, source ? (await getImage({ src: source, width: 640, format: 'webp', quality: 78 })).src : path];
})));
const live = await getImage({ src: liveSource, width: 660, format: 'webp', quality: 80 });
const discovery = memberDiscovery.ids.map(id => memberCourses.find(course => course.id === id)).filter(Boolean);
const missingLinks = memberCourses.some(course => !course.directUrl);
---
<BaseLayout title="Ta bibliothèque PASS MAO — Le Musicien" description="Choisis ce que tu veux améliorer aujourd’hui. La bibliothèque de tes formations et la PM School pour passer à la pratique." pageClass="library-page member-pass-page" noindex memberArea>
  <div class="lp mp lp-wrap">
    <nav class="mp-topline" aria-label="Ton Pass"><span>PASS MAO <span class="mp-muted">/ Ta bibliothèque</span></span><a href="#pm-school">Retrouver la PM School <span aria-hidden="true">↗</span></a></nav>
    <header class="mp-welcome"><h1>Bienvenue dans ton Pass MAO.</h1><p>Choisis ce que tu veux améliorer aujourd’hui.</p></header>
    <div class="mp-layout">
      <div class="mp-main">
        <section aria-label="Choisir un besoin" class="mp-universes">{memberUniverses.map(universe => <a href="#bibliotheque" data-universe={universe.id} class:list={['mp-universe', `lp-tone-${universe.tone}`]}><OptionIcon name={universe.icon} /><span><strong>{universe.title}</strong><small>{universe.hint}</small></span><span class="mp-universe-arrow" aria-hidden="true">↗</span></a>)}</section>
        <p class="mp-permission">Tu n’as pas besoin de tout suivre. Choisis le problème du moment, apprends ce dont tu as besoin, puis retourne faire de la musique.</p>
        <section class="mp-discovery" aria-labelledby="discovery-title"><div class="mp-section-heading"><h2 id="discovery-title">{memberDiscovery.title}</h2><p>{memberDiscovery.description}</p></div><div class="mp-discovery-grid">{discovery.map(course => course && <a class:list={['mp-discovery-card', `lp-tone-${course.tone}`]} href={course.directUrl || memberAccess.courses} target="_blank" rel="noopener noreferrer"><img src={pictures[course.image!]} alt="" width="150" height="150" loading="lazy" /><div><h3>{course.title}</h3><p>{course.promise}</p><span>{course.directUrl ? 'Ouvrir la formation' : 'Retrouver dans mes cours'} ↗</span></div></a>)}</div></section>
        <section id="bibliotheque" class="mp-library" aria-labelledby="library-title">
          <div class="mp-section-heading"><h2 id="library-title">Ta boîte à outils.</h2><p>{memberCourses.length} formations et ressources, à explorer librement.</p></div>
          <div class="mp-controls" data-member-controls hidden><label class="mp-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" placeholder="Une formation, un sujet…" aria-label="Rechercher dans le Pass" data-member-search /></label><div class="mp-filters" role="group" aria-label="Filtrer par besoin"><button type="button" data-filter="all" aria-pressed="true">Tout le Pass</button>{memberUniverses.map(universe => <button type="button" data-filter={universe.id} aria-pressed="false">{universe.title}</button>)}</div></div>
          <div class="mp-results"><p aria-live="polite" aria-atomic="true" data-member-results>{memberCourses.length} formations et ressources</p><button type="button" class="lp-text-link" data-member-reset hidden>Tout afficher</button></div>
          <p class="mp-context" data-member-context hidden></p>
          {missingLinks && <p class="mp-access-note">Les boutons « Retrouver dans mes cours » ouvrent ton espace Systeme.io : connecte-toi, puis choisis la formation.</p>}
          <div class="mp-grid">{memberCourses.map(course => <MemberCourse course={course} image={pictures[course.image!]} loginUrl={memberAccess.courses} />)}</div>
          <div class="mp-empty" data-member-empty hidden><h3>Aucun résultat pour cette recherche.</h3><p>Essaie « mixage », « EQ » ou un autre besoin.</p><button type="button" class="lp-button lp-button-outline" data-member-reset>Retrouver tout le Pass</button></div>
          <button type="button" class="lp-button lp-button-outline mp-more" data-member-more hidden>Voir plus de formations</button>
          <noscript><p>Les formations sont toutes affichées. Utilise la recherche de ton navigateur pour retrouver un titre.</p></noscript>
        </section>
        <aside class="mp-bottom"><div><h2>Une idée apprise ? Essaie-la.</h2><p>Un brouillon, un défi, un morceau à partager. La suite se passe aussi avec les autres.</p></div><a href="#pm-school" class="lp-text-link">Retrouver la PM School ↗</a></aside>
      </div>
      <aside class="mp-school" id="pm-school" aria-labelledby="school-title"><div class="mp-school-inner"><span class="mp-school-label"><OptionIcon name="people" />La PM School</span><h2 id="school-title">Apprendre, c’est bien.<br />Pratiquer, c’est mieux.</h2><p>Dans le Pass, tu apprends à résoudre un problème. Dans la PM School, tu crées et tu gardes le rythme avec d’autres musiciens.</p><img src={live.src} width="660" height={live.attributes.height} alt="Vince et les membres de la PM School réunis lors d’un live en visioconférence" loading="lazy" /><ul><li>Relève les défis créatifs.</li><li>Pratique régulièrement.</li><li>Partage tes morceaux.</li><li>Retrouve les lives et les écoutes.</li></ul><a class="lp-button" href={memberAccess.school} target="_blank" rel="noopener noreferrer">Aller à la PM School <span aria-hidden="true">↗</span></a><a class="mp-school-invitation" href={memberAccess.schoolInvitation} target="_blank" rel="noopener noreferrer">Pas encore inscrit ? Rejoindre la PM School ↗</a></div></aside>
    </div>
  </div>
</BaseLayout>
<script define:vars={{ notes: Object.fromEntries(memberUniverses.map(universe => [universe.id, universe.note || ''])) }}>
  (() => {
    const root = document.querySelector('.mp');
    const controls = root.querySelector('[data-member-controls]');
    const search = root.querySelector('[data-member-search]');
    const cards = [...root.querySelectorAll('[data-member-course]')];
    const filters = [...root.querySelectorAll('[data-filter]')];
    const more = root.querySelector('[data-member-more]');
    const normalize = text => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[’']/g, ' ');
    let selected = 'all', limit = 8;
    const update = () => {
      const terms = normalize(search.value).trim().split(/\s+/).filter(Boolean);
      const matches = cards.filter(card => (selected === 'all' || card.dataset.universes.split(' ').includes(selected)) && terms.every(term => normalize(card.dataset.search).includes(term)));
      cards.forEach(card => card.hidden = true);
      matches.slice(0, limit).forEach(card => card.hidden = false);
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === selected)));
      root.querySelectorAll('[data-universe]').forEach(link => { if(link.dataset.universe === selected) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current'); });
      root.querySelector('[data-member-results]').textContent = `${Math.min(limit, matches.length)} sur ${matches.length} formations et ressources`;
      root.querySelector('[data-member-empty]').hidden = matches.length > 0;
      root.querySelector('.mp-results [data-member-reset]').hidden = selected === 'all' && !search.value;
      const context = root.querySelector('[data-member-context]');
      context.textContent = notes[selected] || '';
      context.hidden = !context.textContent;
      more.hidden = matches.length <= limit;
    };
    const choose = (category, scroll = false) => {
      selected = filters.some(button => button.dataset.filter === category) ? category : 'all';
      limit = 8;
      update();
      if (scroll) document.getElementById('bibliotheque').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    filters.forEach(button => button.addEventListener('click', () => choose(button.dataset.filter)));
    root.querySelectorAll('[data-universe]').forEach(link => link.addEventListener('click', event => { event.preventDefault(); search.value = ''; history.replaceState(null, '', '#besoin-' + link.dataset.universe); choose(link.dataset.universe, true); }));
    search.addEventListener('input', () => { limit = 8; update(); });
    root.querySelectorAll('[data-member-reset]').forEach(button => button.addEventListener('click', () => { search.value = ''; choose('all'); search.focus(); }));
    more.addEventListener('click', () => { const previous = new Set(cards.filter(card => !card.hidden)); limit += 8; update(); const next = cards.find(card => !card.hidden && !previous.has(card)); next?.querySelector('a')?.focus({ preventScroll: true }); });
    controls.hidden = false;
    choose(location.hash.startsWith('#besoin-') ? location.hash.slice(8) : 'all', location.hash.startsWith('#besoin-'));
  })();
</script>
