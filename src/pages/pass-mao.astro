---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  checkoutPlaceholder,
  passFaq,
  passInteractiveCourses,
  passOffers,
  passPaths,
  passRhythm,
} from '../data/pass-mao';
---

<BaseLayout
  title="Pass MAO — Un chemin clair pour ta musique"
  description="Le Pass MAO t’aide à savoir quoi apprendre, quoi appliquer et quoi travailler ensuite pour avancer dans ton home studio."
>
  <div class="pass-page">
    <section class="pass-hero" aria-labelledby="pass-title">
      <div class="pass-wrap pass-hero-inner">
        <div class="pass-hero-copy">
          <p class="pass-eyebrow">Pass MAO</p>
          <h1 id="pass-title">Arrête de tourner en rond <span>dans ton home studio.</span></h1>
          <p class="pass-lead">Le Pass MAO te donne un chemin clair pour progresser en production musicale, appliquer ce que tu apprends et finir plus de musique.</p>
          <div class="pass-hero-actions">
            <a class="pass-button" href={checkoutPlaceholder} data-checkout-placeholder>Rejoindre le Pass MAO <span aria-hidden="true">→</span></a>
            <a class="pass-hero-secondary" href="#comment-ca-marche">Découvrir comment ça marche <span aria-hidden="true">↓</span></a>
          </div>
          <div class="pass-founder-prices" aria-label="Tarifs Founder">
            <p><strong>39€</strong> /mois <span>Founder</span></p>
            <p><strong>299€</strong> /an <span>Founder</span></p>
          </div>
          <p class="pass-price-note">Tarif membre Founder conservé tant que ton abonnement reste actif.</p>
          <p class="pass-hero-proof">Créé par Vince, musicien, producteur, ancien compositeur pour RTL et formateur de milliers de musiciens.</p>
        </div>
        <figure class="pass-hero-visual">
          <img class="pass-hero-product" src="/images/pass/pass-mao-visuel.png" alt="Carte membre premium du Pass MAO dans un home studio" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="pass-section pass-problem" aria-labelledby="problem-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">Tu reconnais ça ?</p>
        <h2 id="problem-title">Tu apprends beaucoup. Mais est-ce que ta musique avance vraiment ?</h2>
        <ul class="pass-symptoms">
          <li>Tu regardes beaucoup de tutos, mais tu ne sais plus quoi travailler.</li>
          <li>Tu commences des morceaux qui restent inachevés.</li>
          <li>Tu passes du temps sur des détails techniques sans savoir si c’est vraiment la priorité.</li>
          <li>Tu accumules plugins, techniques et idées, mais tu progresses un peu au hasard.</li>
          <li>Tu ouvres ton DAW sans toujours savoir par quoi commencer.</li>
        </ul>
        <p class="pass-problem-conclusion">Le problème n’est pas forcément le manque d’informations. C’est souvent le <strong>manque de direction.</strong></p>
      </div>
    </section>

    <section class="pass-section pass-loop" id="comment-ca-marche" aria-labelledby="loop-title">
      <div class="pass-wrap">
        <header class="pass-section-heading">
          <p class="pass-eyebrow">Comment ça marche</p>
          <h2 id="loop-title">Apprends. Applique. Avance.</h2>
          <p>Le Pass ne te donne pas seulement des ressources. Il t’aide à choisir la prochaine action utile pour ta musique.</p>
        </header>
        <ol class="pass-loop-list">
          <li><strong>Diagnostic</strong><span>Tu identifies ton niveau, ton objectif et ton vrai blocage.</span></li>
          <li><strong>Parcours</strong><span>Le Pass te recommande un chemin adapté, sans fouiller partout.</span></li>
          <li><strong>Action</strong><span>Chaque étape débouche sur quelque chose de concret dans ton DAW ou ton projet.</span></li>
          <li><strong>Résultat</strong><span>Un morceau avance, un mix se débloque, une compétence devient plus claire.</span></li>
        </ol>
        <p class="pass-flow" aria-label="Progression du Pass">Diagnostic <span>→</span> Parcours <span>→</span> Action <span>→</span> Résultat</p>
      </div>
    </section>

    <section class="pass-section pass-next-step" aria-labelledby="next-step-title">
      <div class="pass-wrap pass-next-step-inner">
        <div>
          <p class="pass-eyebrow">Le cœur du Pass</p>
          <h2 id="next-step-title">Ton prochain pas.</h2>
          <p>Quand tu te connectes, tu ne devrais pas te demander « Qu’est-ce que je regarde aujourd’hui ? »</p>
          <p class="pass-large-copy">Le Pass te répond : <strong>« Voilà ce que je te recommande maintenant. »</strong></p>
        </div>
        <article class="pass-next-card" aria-label="Exemple de recommandation du Pass">
          <p class="pass-next-card-label">Ton prochain pas</p>
          <dl>
            <div><dt>Focus actuel</dt><dd>Finir ton morceau</dd></div>
            <div><dt>Prochaine action</dt><dd>Dessine la courbe d’énergie de ton morceau.</dd></div>
            <div><dt>Durée</dt><dd>10–15 min</dd></div>
          </dl>
          <span class="pass-next-card-action">Continuer <i aria-hidden="true">→</i></span>
        </article>
      </div>
    </section>

    <section class="pass-section pass-paths" aria-labelledby="paths-title">
      <div class="pass-wrap">
        <header class="pass-section-heading pass-heading-split">
          <div><p class="pass-eyebrow">Les parcours</p><h2 id="paths-title">Choisis l’objectif qui compte maintenant.</h2></div>
          <p>Les parcours utilisent les formations, ressources et méthodes déjà présentes dans le Pass. Ce sont des repères, pas un programme scolaire.</p>
        </header>
        <div class="pass-paths-grid">
          {passPaths.map((path) => (
            <article class:list={['pass-path-card', `option-${path.accent}`]}>
              <span class="pass-path-number">{path.number}</span>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <ul>{path.courses.map((course) => <li>{course}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pass-section pass-ninety" aria-labelledby="ninety-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">Un objectif, 90 jours</p>
        <h2 id="ninety-title">Où pourrait en être ta musique dans 90 jours ?</h2>
        <p>Pas besoin de tout apprendre. Choisis un objectif réaliste et fais-le avancer pendant 90 jours : terminer un morceau, débloquer une production, réaliser un vrai mix, installer un workflow ou développer une compétence précise.</p>
        <p class="pass-ninety-emphasis">Faire de la musique reste le meilleur moyen de progresser en musique.</p>
      </div>
    </section>

    <section class="pass-section pass-catalogue" aria-labelledby="catalogue-title">
      <div class="pass-wrap">
        <header class="pass-section-heading pass-heading-split">
          <div><p class="pass-eyebrow">La bibliothèque</p><h2 id="catalogue-title">Et quand tu as besoin d’aller plus loin, toute la bibliothèque est là.</h2></div>
          <p>Les formations sont la bibliothèque. Le Pass te donne le chemin. Tu peux approfondir le besoin du moment sans devoir tout regarder.</p>
        </header>
        <div class="pass-training-grid" data-training-grid>
          {passInteractiveCourses.map((course, index) => (
            <article class:list={['pass-training-card', `option-${course.accent}`]} data-training-card>
              <button
                class="pass-training-summary"
                type="button"
                aria-expanded="false"
                aria-controls={`pass-training-details-${index}`}
                data-training-trigger
              >
                <span class="pass-training-media" aria-hidden="true">
                  <img src={course.image} alt="" loading="lazy" />
                </span>
                <span class="pass-training-meta">{course.category} <i>·</i> {course.format}</span>
                <h3>{course.title}</h3>
                <span class="pass-training-promise">{course.promise}</span>
                <span class="pass-training-value">Valeur {course.value}</span>
                <span class="pass-training-action">Voir ce que tu vas apprendre <i aria-hidden="true">+</i></span>
              </button>
              <div class="pass-training-details" id={`pass-training-details-${index}`} data-training-details aria-hidden="true">
                <div>
                  <p>{course.description}</p>
                  <ul>
                    {course.benefits.map((benefit) => <li>{benefit}</li>)}
                  </ul>
                  <p class="pass-training-included">Valeur {course.value} <span>· Inclus dans le Pass</span></p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="pass-catalogue-more">Et aussi : Comprendre l’EQ, Comprendre la Compression, Arrangements MAO, Workflow Efficace, Musicien Productif, Écouter comme un Producer et d’autres ressources pour créer, produire et faire sonner ta musique.</p>
      </div>
    </section>

    <section class="pass-section pass-rhythm" aria-labelledby="rhythm-title">
      <div class="pass-wrap">
        <header class="pass-section-heading">
          <p class="pass-eyebrow">Le rythme du Pass</p>
          <h2 id="rhythm-title">Chaque mois, une raison simple de faire de la musique.</h2>
          <p>Le but n’est pas de t’ajouter du contenu à consommer. Le but est de t’aider à garder un cap et à créer.</p>
        </header>
        <div class="pass-rhythm-grid">
          {passRhythm.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pass-section pass-school" aria-labelledby="school-title">
      <div class="pass-wrap pass-school-inner">
        <div class="pass-school-copy">
          <p class="pass-eyebrow">La PM School</p>
          <h2 id="school-title">Un espace pour ne pas rester seul avec tes morceaux.</h2>
          <p>La PM School existe depuis plusieurs années : un espace à taille humaine où tu peux partager un extrait, demander un feedback, publier ton objectif ou participer à un challenge.</p>
          <p class="pass-school-value">Valeur : <strong>120€/an</strong></p>
          <ul class="pass-check-list">
            <li>Un défi créatif chaque mois</li>
            <li>Un live mensuel d’écoute et feedback</li>
            <li>Des replays, petits tutos et contenus exclusifs</li>
            <li>Une communauté de musiciens qui se connaissent et échangent</li>
            <li>Une application iOS et Android dédiée, pour rester connectés</li>
          </ul>
          <p class="pass-school-optional">Tu peux tirer énormément de valeur du Pass sans participer à tout.</p>
        </div>
        <figure class="pass-school-shot">
          <img src="/images/pass/pm-school.png" alt="Aperçu de la PM School" loading="lazy" />
          <figcaption>Apprendre → mettre en pratique → partager → progresser → continuer.</figcaption>
        </figure>
      </div>
    </section>

    <section class="pass-section pass-anti-overwhelm" aria-labelledby="overwhelm-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">Une règle importante</p>
        <h2 id="overwhelm-title">Tu n’as rien à rattraper.</h2>
        <p>Tu n’as pas besoin de regarder toutes les formations, de participer à tous les lives, de relever tous les challenges ou d’utiliser 100 % du Pass.</p>
        <p class="pass-large-copy">Tu utilises ce dont tu as besoin <strong>maintenant</strong>. Le Pass doit t’aider à avancer, pas devenir une nouvelle liste de choses à faire.</p>
      </div>
    </section>

    <section class="pass-section pass-pricing" id="tarifs" aria-labelledby="pricing-title">
      <div class="pass-wrap">
        <header class="pass-section-heading"><p class="pass-eyebrow">Tarif Founder</p><h2 id="pricing-title">Choisis le rythme qui te convient.</h2><p>Le tarif Founder est conservé tant que ton abonnement reste actif.</p></header>
        <div class="pass-pricing-grid">
          {passOffers.map((offer) => (
            <article class:list={['pass-price-card', { 'pass-price-card--featured': offer.key === 'annual' }]}>
              {offer.key === 'annual' && <p class="pass-price-ribbon">Meilleur rapport qualité/prix</p>}
              <p class="pass-price-eyebrow">{offer.eyebrow}</p>
              <p class="pass-price"><strong>{offer.price}</strong> <span>{offer.suffix}</span></p>
              <p class="pass-price-description">{offer.description}</p>
              <a class:list={['pass-button', { 'pass-button--quiet': offer.key !== 'annual' }]} href={checkoutPlaceholder} data-checkout-placeholder>{offer.cta} <span aria-hidden="true">→</span></a>
              {offer.note && <p class="pass-price-note pass-price-note--card">{offer.note}</p>}
            </article>
          ))}
        </div>
        <p class="pass-loyalty-note">Déjà membre de la PM School ? <strong>Contacte-moi dans la School ;)</strong></p>
      </div>
    </section>

    <section class="pass-section pass-legacy" aria-labelledby="legacy-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">Déjà client ?</p>
        <h2 id="legacy-title">Tes anciennes formations restent à toi.</h2>
        <p>Selon les conditions d’achat initiales, tes formations déjà achetées restent accessibles. Le Pass donne accès au système de progression, à la bibliothèque, aux nouvelles ressources et à la PM School.</p>
      </div>
    </section>

    <section class="pass-section pass-faq" aria-labelledby="faq-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">FAQ</p>
        <h2 id="faq-title">Quelques questions légitimes.</h2>
        <div class="pass-faq-list">
          {passFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="pass-final" aria-labelledby="final-title">
      <div class="pass-narrow">
        <p class="pass-eyebrow">Le Pass MAO</p>
        <h2 id="final-title">Dans 90 jours, tu peux encore regarder des tutos au hasard. <span>Ou savoir exactement ce que tu es en train de construire.</span></h2>
        <p>Moins consommer. Plus créer. La technique doit servir la musique, pas l’inverse.</p>
        <a class="pass-button" href={checkoutPlaceholder} data-checkout-placeholder>Rejoindre le Pass MAO <span aria-hidden="true">→</span></a>
        <p class="pass-final-price">39€/mois Founder ou 299€/an Founder<br />Tu gardes ton tarif Founder tant que ton abonnement reste actif.</p>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('[data-training-card]'));

      cards.forEach((card) => {
        const trigger = card.querySelector('[data-training-trigger]');
        const details = card.querySelector('[data-training-details]');

        trigger?.addEventListener('click', () => {
          const willOpen = trigger.getAttribute('aria-expanded') !== 'true';

          cards.forEach((item) => {
            item.classList.remove('is-open');
            item.querySelector('[data-training-trigger]')?.setAttribute('aria-expanded', 'false');
            item.querySelector('[data-training-details]')?.setAttribute('aria-hidden', 'true');
          });

          if (willOpen) {
            card.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
            details?.setAttribute('aria-hidden', 'false');
          }
        });
      });
    })();
  </script>
</BaseLayout>
