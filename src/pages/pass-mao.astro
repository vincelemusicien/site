---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCover from '../components/CourseCover.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { libraryCourses, libraryCategories, passCheckout, passQuestions } from '../data/pass-library';
import '../styles/pass-library.css';

const sourceImages = import.meta.glob<{ default: ImageMetadata }>('../../public/images/**/*.{png,webp}', { eager: true });
const pmSchoolScreens = [
  { path: '/images/pass/pm-school-training.png', alt: 'Espace de formation continue de la PM School', label: 'Se former' },
  { path: '/images/pass/pm-school-feed.png', alt: 'Fil de discussion et de partage de morceaux de la PM School', label: 'Partager' },
  { path: '/images/pass/pm-school-menu.png', alt: 'Les espaces et rendez-vous de la communauté PM School', label: 'Pratiquer' },
];
const imagePaths = [...new Set([...libraryCourses.map((course) => course.image), '/images/vince-home-studio.png', ...pmSchoolScreens.map((screen) => screen.path)].filter(Boolean))] as string[];
const pictures = Object.fromEntries(await Promise.all(imagePaths.map(async (path) => {
  const source = sourceImages[`../../public${path}`]?.default;
  return [path, source ? (await getImage({ src: source, width: path.includes('pm-school') ? 1000 : 640, format: 'webp', quality: 78 })).src : path];
})));
const heroCourses = [libraryCourses[1], libraryCourses[0], libraryCourses[3], libraryCourses[5], libraryCourses[2], libraryCourses[4]];
const categoryName = (id: string) => libraryCategories.find((category) => category.id === id)?.label;
---

<BaseLayout title="PASS MAO — Toute ta musique. Un seul Pass." description="La bibliothèque de formations de Vince pour composer, produire, mixer et finir tes morceaux. Tout le catalogue du Pass et la PM School : 39 €/mois ou 299 €/an." image="/images/pass/pass-mao-visuel.png" pageClass="library-page">
  <div class="lp">
    <nav class="lp-subnav lp-wrap" aria-label="Le Pass MAO">
      <a class="lp-wordmark" href="#contenu">PASS MAO<span>par Vince</span></a>
      <div><a href="#bibliotheque">La bibliothèque</a><a href="#tarifs">Les tarifs</a><a class="lp-nav-join" href="#tarifs">Choisir mon Pass</a></div>
    </nav>

    <section class="lp-hero lp-wrap" aria-labelledby="lp-title">
      <div class="lp-hero-copy">
        <h1 id="lp-title">Toute ta musique.<br />Un seul Pass.</h1>
        <p class="lp-lead">La bibliothèque de formations pour <strong>composer, produire, mixer et finir tes morceaux.</strong> Et une communauté pour les mettre en pratique, partager et continuer d’avancer.</p>
        <div class="lp-hero-price"><strong>39 €<span>/mois</span></strong><p>ou <b>299 €/an</b><br />Tout le catalogue du Pass inclus.</p></div>
        <div class="lp-actions"><a class="lp-button" href="#tarifs">Choisir mon Pass<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a><a class="lp-text-link" href="#bibliotheque">Explorer les formations</a></div>
        <p class="lp-small">Tarif de lancement. Mensuel sans engagement.</p>
      </div>
      <div class="lp-sleeves" aria-label="Un aperçu des formations incluses">
        {heroCourses.map((course, index) => (
          <a class:list={['lp-sleeve', `lp-tone-${course.category}`]} href={`#cours-${course.id}`} data-course-link={course.id}>
            <div class="lp-sleeve-title"><span>{categoryName(course.category)}</span><strong>{course.title.replace('La Méthode ', '').replace('La méthode ', '')}</strong></div>
            <img src={pictures[course.image!]} alt="" width="320" height="210" loading={index < 3 ? 'eager' : 'lazy'} fetchpriority={index === 1 ? 'high' : 'auto'} />
            <span class="lp-sleeve-foot">Inclus dans le Pass<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
          </a>
        ))}
      </div>
    </section>

    <div class="lp-reassurance lp-wrap"><p>De la première idée au morceau terminé.</p><p>Avec Vince, formateur de <strong>plusieurs milliers de musiciens.</strong></p></div>

    <section class="lp-catalogue lp-wrap" id="bibliotheque" aria-labelledby="library-title">
      <div class="lp-section-intro"><h2 id="library-title">Oui, tout ça.<br />Dans ton Pass.</h2><div><p>Un mix à éclaircir. Une idée à développer. Un morceau à finir. <strong>Pioche selon ce qui compte pour toi, aujourd’hui.</strong></p><span class="lp-included">{libraryCourses.length} formations & ressources à explorer</span></div></div>
      <div class="lp-needs" data-enhanced hidden><span>En ce moment…</span><button type="button" data-need="mix">Mon mix manque de clarté</button><button type="button" data-need="create">Je tourne en rond sur 8 mesures</button><button type="button" data-need="workflow">Je veux finir mes morceaux</button></div>
      <div class="lp-library-controls" data-enhanced hidden>
        <div class="lp-filters" role="group" aria-label="Filtrer les formations par univers">{libraryCategories.map((category) => <button type="button" data-category={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'}>{category.label}</button>)}</div>
        <label class="lp-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg><input type="search" placeholder="Une formation, un sujet…" aria-label="Rechercher une formation" autocomplete="off" data-search /></label>
      </div>
      <p class="lp-result-count" data-enhanced hidden aria-live="polite" aria-atomic="true" data-results></p>
      <div class="lp-course-grid" data-grid>
        {libraryCourses.map((course, index) => (
          <article class:list={['lp-course', `lp-tone-${course.category}`]} data-course data-category-id={course.category} data-search-text={`${course.title} ${course.promise} ${course.description}`} id={`cours-${course.id}`}>
            <details>
              <summary>
                <CourseCover title={course.title} category={categoryName(course.category) || ''} image={course.image ? pictures[course.image] : null} />
                <div class="lp-course-copy"><p>{course.promise}</p><span class="lp-course-meta"><span>{course.format || 'Formation & ressources'}</span><span class="lp-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg></span></span><span class="sr-only">Voir le détail de {course.title}</span></div>
              </summary>
              <div class="lp-course-details"><p>{course.description}</p>{course.benefits.length > 0 && <ul>{course.benefits.map((benefit) => <li>{benefit}</li>)}</ul>}<a href="#tarifs">Accéder avec le Pass</a></div>
            </details>
          </article>
        ))}
      </div>
      <div class="lp-empty" data-empty hidden><h3>Aucune formation pour cette recherche.</h3><p>Essaie « mixage », « composition » ou « Logic ».</p><button class="lp-button lp-button-outline" type="button" data-reset>Réinitialiser les filtres</button></div>
      <div class="lp-more" data-enhanced hidden><button class="lp-button lp-button-outline" type="button" data-more aria-expanded="false">Explorer les {libraryCourses.length} formations<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button><p>Et une bibliothèque qui s’enrichit au fil du temps.</p></div>
      <aside class="lp-value"><p><strong>Plus de 2 000 € de contenus réunis.</strong><br />Les formations, les ressources et la PM School dans un même espace.</p><p><strong>Avec le Pass : 39 €/mois ou 299 €/an.</strong><br />Tu explores ce dont ton morceau a besoin, quand tu en as besoin.</p><span>Accès à toute la bibliothèque pendant ton abonnement</span></aside>
    </section>

    <section class="lp-manifesto" aria-labelledby="manifesto-title"><div class="lp-wrap lp-manifesto-inner"><h2 id="manifesto-title">Une bibliothèque.<br />Pas une liste de devoirs.</h2><div><p>Tu n’as pas besoin de tout regarder pour que le Pass change quelque chose à ta musique.</p><p><strong>Un problème. Une formation. Un morceau qui avance.</strong> Tu prends ce qu’il te faut, tu l’appliques dans ton DAW, puis tu retournes faire de la musique.</p><a href="#bibliotheque" class="lp-text-link">Trouver mon point de départ</a></div></div></section>

    <section class="lp-vince lp-wrap" aria-labelledby="vince-title"><figure><img src={pictures['/images/vince-home-studio.png']} alt="Vince dans son home studio, au travail dans son logiciel de production musicale" width="640" height="427" loading="lazy" /><figcaption>Vince / Le Musicien</figcaption></figure><div><h2 id="vince-title">Faire de la musique.<br />Avec ce qu’on a.</h2><p>C’est le fil rouge de mes formations : développer ton écoute, garder les choses simples et apprendre en faisant. Tu peux créer avant de tout comprendre parfaitement.</p><p>Je suis Vince. J’enseigne la MAO depuis des années et j’ai accompagné plusieurs milliers de musiciens à travers mes formations. J’ai aussi travaillé comme compositeur, notamment pour RTL.</p><p class="lp-vince-note">Ici, la technique sert tes morceaux.<br />Et pas l’inverse.</p></div></section>

    <section class="lp-community lp-wrap" aria-labelledby="school-title">
      <div class="lp-community-copy">
        <span class="lp-community-label">La PM School est incluse</span>
        <h2 id="school-title">Le catalogue t’apprend.<br />La communauté te fait pratiquer.</h2>
        <p>Tu apprends une méthode dans la bibliothèque, puis tu viens l’essayer sur un vrai morceau. Dans la PM School, tu peux publier un brouillon, demander un retour et trouver l’élan pour terminer.</p>
        <ol class="lp-practice-loop" aria-label="Comment le catalogue et la communauté se complètent"><li><span>01</span>Apprendre</li><li><span>02</span>Essayer</li><li><span>03</span>Partager</li><li><span>04</span>Avancer</li></ol>
        <ul><li>Un défi créatif pour passer à l’action chaque mois</li><li>Un live mensuel d’écoute et de retours avec Vince</li><li>Des échanges bienveillants avec d’autres musiciens</li><li>Les replays et ressources sur mobile et ordinateur</li></ul>
        <p class="lp-small">Tu participes quand cela aide ta musique. Aucun rythme ne t’est imposé.</p>
      </div>
      <div class="lp-community-gallery" aria-label="Aperçu de la PM School">
        {pmSchoolScreens.map((screen, index) => <figure class={`lp-community-shot lp-community-shot-${index + 1}`}><img src={pictures[screen.path]} alt={screen.alt} loading="lazy" width="520" height="1125" /><figcaption>{screen.label}</figcaption></figure>)}
      </div>
    </section>

    <section class="lp-pricing" id="tarifs" aria-labelledby="pricing-title"><div class="lp-wrap"><div class="lp-section-intro"><h2 id="pricing-title">Tout le Pass.<br />À ton rythme.</h2><p>La bibliothèque, les ressources et la PM School.<br />Le même accès, deux façons de le rejoindre.</p></div><div class="lp-pricing-grid">
      <article class="lp-price-card"><div class="lp-plan-heading"><h3>Un mois à la fois</h3><span>Offre de lancement</span></div><p class="lp-price"><strong>39 €</strong><span>/mois</span></p><p>Pour explorer librement, sans engagement.</p><p class="lp-future-price">Puis <strong>49 €/mois</strong> pour les nouvelles inscriptions.</p><ul><li>Tout le catalogue du Pass</li><li>La PM School et ses rendez-vous</li><li>La bibliothèque grossit régulièrement</li></ul>{passCheckout.monthly ? <a class="lp-button lp-button-outline" href={passCheckout.monthly}>Choisir le Pass mensuel</a> : <a class="lp-button lp-button-outline" href="#inscription" data-plan="mensuel">Choisir le Pass mensuel</a>}<p class="lp-small">Facturation mensuelle. Résiliable à tout moment.</p></article>
      <article class="lp-price-card lp-price-annual"><div class="lp-plan-heading"><h3>Une année pour créer</h3><span>Offre de lancement</span></div><p class="lp-price"><strong>299 €</strong><span>/an</span></p><p>Soit <strong>24,92 €/mois</strong>, facturés en une fois.</p><p class="lp-future-price">Puis <strong>399 €/an</strong> pour les nouvelles inscriptions.</p><ul><li>Le même accès complet au Pass</li><li>Une année de musique devant toi</li><li>169 € économisés face à 12 mensualités</li></ul>{passCheckout.annual ? <a class="lp-button" href={passCheckout.annual}>Choisir le Pass annuel</a> : <a class="lp-button" href="#inscription" data-plan="annuel">Choisir le Pass annuel</a>}<p class="lp-small">299 € au lieu de 468 € pour 12 mensualités.</p></article>
    </div><p class="lp-price-footnote"><strong>Tu gardes ton tarif de lancement</strong> tant que ton abonnement reste actif.</p>
    {(!passCheckout.monthly || !passCheckout.annual) && <aside id="inscription" class="lp-checkout-note" tabindex="-1"><h3>Rejoindre le Pass MAO</h3><p data-checkout-message>L’inscription en ligne n’est pas encore disponible. Pour rejoindre le Pass, contacte Vince.</p><a class="lp-text-link" href="mailto:contact@lemusicien.fr?subject=Rejoindre%20le%20Pass%20MAO" data-contact>Contacter Vince</a></aside>}
    </div></section>

    <section class="lp-faq lp-wrap" aria-labelledby="faq-title"><h2 id="faq-title">Encore une question ?</h2><div>{passQuestions.map((item) => <details><summary>{item.question}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary><p>{item.answer}</p></details>)}</div></section>
    <section class="lp-close lp-wrap"><h2>Ton prochain morceau<br />a de quoi avancer.</h2><a class="lp-button" href="#tarifs">Choisir mon Pass<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a><p>39 €/mois ou 299 €/an. À toi de jouer.</p></section>
    <div class="lp-mobile-cta" data-mobile-cta hidden><p><strong>Le Pass MAO</strong><span>39 €/mois ou 299 €/an</span></p><a class="lp-button" href="#tarifs">Choisir mon Pass</a></div>
  </div>
  <script>
    const root = document.querySelector<HTMLElement>('.lp');
    if (root) {
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-course]'));
      const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-category]'));
      const search = root.querySelector<HTMLInputElement>('[data-search]')!;
      const results = root.querySelector<HTMLElement>('[data-results]')!;
      const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
      const empty = root.querySelector<HTMLElement>('[data-empty]')!;
      let category = 'all', expanded = false;
      const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      function render() {
        const query = normalize(search.value.trim());
        const matches = cards.filter((card) => (category === 'all' || card.dataset.categoryId === category) && normalize(card.dataset.searchText || '').includes(query));
        const limit = expanded || category !== 'all' || query ? matches.length : 8;
        const visible = new Set(matches.slice(0, limit));
        cards.forEach((card) => { card.hidden = !visible.has(card); if (card.hidden) card.querySelector('details')!.open = false; });
        filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === category)));
        root!.querySelectorAll<HTMLButtonElement>('[data-need]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.need === category)));
        results.textContent = `${Math.min(limit, matches.length)} sur ${matches.length} formations & ressources${category === 'all' ? '' : ` — ${filters.find((button) => button.dataset.category === category)?.textContent}`}`;
        empty.hidden = matches.length !== 0;
        more.parentElement!.hidden = category !== 'all' || !!query || expanded || matches.length <= 8;
        more.setAttribute('aria-expanded', String(expanded));
      }
      root.querySelectorAll<HTMLElement>('[data-enhanced]').forEach((element) => element.hidden = false);
      filters.forEach((button) => button.addEventListener('click', () => { category = button.dataset.category!; expanded = false; render(); }));
      root.querySelectorAll<HTMLButtonElement>('[data-need]').forEach((button) => button.addEventListener('click', () => { category = button.dataset.need!; search.value = ''; expanded = false; render(); }));
      search.addEventListener('input', render);
      more.addEventListener('click', () => { expanded = true; render(); cards[8]?.querySelector('summary')?.focus({ preventScroll: true }); });
      root.querySelector('[data-reset]')?.addEventListener('click', () => { category = 'all'; search.value = ''; expanded = false; render(); search.focus(); });
      function showCourse(id: string) {
        const card = document.getElementById(`cours-${id}`);
        if (!card) return;
        category = 'all'; search.value = ''; expanded = true; render();
        card.querySelector('details')!.open = true;
        card.querySelector('summary')?.focus({ preventScroll: true });
      }
      root.querySelectorAll<HTMLAnchorElement>('[data-course-link]').forEach((link) => link.addEventListener('click', () => showCourse(link.dataset.courseLink!)));
      window.addEventListener('hashchange', () => { if (location.hash.startsWith('#cours-')) showCourse(location.hash.slice(7)); });
      render();
      if (location.hash.startsWith('#cours-')) showCourse(location.hash.slice(7));
      root.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach((link) => link.addEventListener('click', () => {
        const plan = link.dataset.plan!;
        root.querySelector('[data-checkout-message]')!.textContent = `Tu as choisi le Pass ${plan}. L’inscription en ligne n’est pas encore disponible ; contacte Vince pour le rejoindre.`;
        root.querySelector<HTMLAnchorElement>('[data-contact]')!.href = `mailto:contact@lemusicien.fr?subject=${encodeURIComponent(`Rejoindre le Pass MAO ${plan}`)}`;
        root.querySelector<HTMLElement>('#inscription')?.focus({ preventScroll: true });
      }));
      const sticky = root.querySelector<HTMLElement>('[data-mobile-cta]')!;
      let pastHero = false, pricingVisible = false, closeVisible = false;
      const updateSticky = () => { sticky.hidden = !pastHero || pricingVisible || closeVisible; };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.target.classList.contains('lp-hero')) pastHero = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          if (entry.target.id === 'tarifs') pricingVisible = entry.isIntersecting;
          if (entry.target.classList.contains('lp-close')) closeVisible = entry.isIntersecting;
        }); updateSticky();
      });
      ['.lp-hero', '#tarifs', '.lp-close'].forEach((selector) => observer.observe(root.querySelector(selector)!));
    }
  </script>
</BaseLayout>
